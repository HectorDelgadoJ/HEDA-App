# Copy this file to .env.local and fill in the public project settings.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Opcional: activar ambos valores solo después de alojar security/captcha.
# La clave PRIVADA de Turnstile se configura únicamente en Supabase Auth.
EXPO_PUBLIC_CAPTCHA_URL=
EXPO_PUBLIC_CAPTCHA_SITE_KEY=
